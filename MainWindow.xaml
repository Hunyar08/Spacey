                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Filter by name or path" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="FilterTypeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="FilterTypeBox_SelectionChanged">
                    <ComboBoxItem Content="All entries" />
                    <ComboBoxItem Content="Files" />
                    <ComboBoxItem Content="Folders" />
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1" Padding="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="98" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="NAME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="LOCATION" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="TYPE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="SIZE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
            </Grid>

            <ListView x:Name="EntriesList" Grid.Row="2" ItemsSource="{x:Bind Entries}" SelectionMode="None" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="54" Padding="10,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="98" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="17" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" />
                            <TextBlock Grid.Column="3" Text="{Binding Kind}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="5" Click="OpenLocation_Click" Padding="7" Background="Transparent" ToolTipService.ToolTip="Show in File Explorer">
                                <FontIcon Glyph="&#xE8B7;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="4" Margin="34,12,34,18" Text="Folder totals are estimates from indexed file results. Use File Explorer to review items before deleting anything." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
