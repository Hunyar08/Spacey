                <ComboBox x:Name="ThemeSelector" Width="128" Height="40" SelectionChanged="ThemeSelector_SelectionChanged" ToolTipService.ToolTip="App theme">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Dark" />
